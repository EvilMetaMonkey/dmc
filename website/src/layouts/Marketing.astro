---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/marketing.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'dmc is a local shadow-history vault for AI-assisted coding. Haven is the review cockpit that proposes, approves, and recovers edits. No cloud. No telemetry.',
} = Astro.props;

const repo = 'https://github.com/EvilMetaMonkey/dmc';

const mark = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10" stroke="#fbbf24"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" stroke="#22d3ee"></path></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="banner">
      <strong>DEVELOPMENT PREVIEW</strong>
      <span> · </span>
      dmc 1.1.0-dev.5.1 &amp; Haven 0.7.5 — invited trials only, not a public release
    </div>

    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">
          <span class="mark" set:html={mark}></span>
          dmc <span class="plus">+</span> Haven
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#products">Products</a>
          <a href="#workflow">Workflow</a>
          <a href="#honesty">Limits</a>
          <a class="nav-docs" href="/docs/">Docs</a>
          <a class="nav-gh" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="foot-brand">
          <a class="brand" href="/">
            <span class="mark" set:html={mark}></span>
            dmc <span class="plus">+</span> Haven
          </a>
          <p>
            Local-first rollback and review for AI coding agents. The vault stays
            on your machine; neither tool has telemetry.
          </p>
        </div>
        <div>
          <h5>dmc</h5>
          <ul>
            <li><a href="/docs/dmc/">Overview</a></li>
            <li><a href="/docs/dmc/getting-started/">Getting started</a></li>
            <li><a href="/docs/dmc/checkpoints/">Checkpoints</a></li>
            <li><a href="/docs/dmc/recovery/">Recovery</a></li>
          </ul>
        </div>
        <div>
          <h5>Haven</h5>
          <ul>
            <li><a href="/docs/haven/">Overview</a></li>
            <li><a href="/docs/haven/pilot-workflow/">Pilot workflow</a></li>
            <li><a href="/docs/imported/haven-integration/">Integration contract</a></li>
          </ul>
        </div>
        <div>
          <h5>Project</h5>
          <ul>
            <li><a href={repo}>GitHub</a></li>
            <li><a href="/docs/status/">Status &amp; support</a></li>
            <li><a href="/docs/changelog/">Changelog</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 dmc + Haven — unreleased development previews</span>
        <span>"dmc" is a working homage name; not affiliated with any vehicle manufacturer.</span>
      </div>
    </footer>
  </body>
</html>
